# Copy this file to .env.local for local dev, and add the same variables
# in Vercel → Project Settings → Environment Variables for production.

# The site's own URL. Used to build links in emails (pass unlock links,
# etc). Set to your real domain in production.
NEXT_PUBLIC_SITE_URL=https://horrorscope.art

# --- AI readings ---
# Anthropic API key, powers the Bright Side / Horror Mirror / Change Your
# Fate readings. Get one at https://console.anthropic.com.
# Without it, the app still works — it falls back to the 720 pre-written
# static readings, so this is optional for a basic deploy.
ANTHROPIC_API_KEY=

# --- Transactional email ---
# Resend API key, sends the welcome email and Veil Season Pass unlock
# links. Get one free at https://resend.com — you'll also need to verify
# the horrorscope.art domain there so "moira@horrorscope.art" can send.
# Without it, emails are logged to the server console instead of sent.
RESEND_API_KEY=

# --- Veil Season Pass ($9.99 one-time, unlimited fate rewrites) ---
# See the "HorrorScope — Veil Season Pass Setup" doc for the full Stripe
# dashboard walkthrough. Summary:
#   1. Create a product ($9.99, one-time) in Stripe, then a Payment Link
#      from it, with "Collect customer email" turned ON.
#   2. Developers → API keys → Secret key.
#   3. Developers → Webhooks → add an endpoint at
#      https://horrorscope.art/api/stripe/webhook for the
#      checkout.session.completed event → reveal its Signing secret.
# Do this in Stripe test mode first (sk_test_ / whsec_test_), confirm the
# whole flow works, then switch to live keys.

# Any long random string. Generate once with (PowerShell):
#   [Convert]::ToBase64String((1..48|%{Get-Random -Max 256}))
# NEVER change this after going live — it invalidates every pass already
# sold, since passes are signed tokens rather than database rows.
PASS_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# The Payment Link from step 1 above (https://buy.stripe.com/...). Until
# this is a real link, the site shows "Coming Soon" instead of a purchase
# button — it will not link to a broken/placeholder URL.
NEXT_PUBLIC_PAYMENT_LINK=

# --- Social links (footer) ---
# Once these three accounts exist, paste their URLs here and the footer
# automatically shows links to them — no code change needed. Leave any of
# them blank to hide that link; the whole row hides if all three are blank.
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_YOUTUBE_URL=
